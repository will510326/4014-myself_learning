# Local .terraform directories
**/.terraform/*

# .tfstate files
# Terraform state files contain the actual state of your infrastructure and often sensitive data.
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data.
# These should be managed through other means, such as environment variables or secret management tools.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local testing and should not be shared.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: exclude the plan output file (if you use 'terraform plan -out=tfplan')
# *tfplan*

# Optional: ignore graph output files generated by `terraform graph`
# *.svg
# *.png

# macOS temporary file
.DS_Store
